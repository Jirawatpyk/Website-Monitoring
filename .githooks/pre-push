#!/bin/sh
# Refuse pushes to main (D-008): the repository is private on GitHub Free, so GitHub doesn't
# enforce the ruleset — changes reach main only by PR, merged with `pnpm pr:merge <number>`.
# Every other push runs `pnpm check` first, so a branch never reaches CI or staging red (retro S04b:
# a commit tested only in its own package broke two route tests).
# Installed by `pnpm install` (scripts/install-git-hooks.mjs sets core.hooksPath to .githooks).
pushes=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: pushing to main is not allowed — open a PR and merge it with 'pnpm pr:merge <number>' (docs/decisions.md D-008)." >&2
    exit 1
  fi
  # A branch deletion pushes nothing to check.
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] || pushes=1
done
if [ "$pushes" = 1 ]; then
  echo "pre-push: running pnpm check…" >&2
  pnpm check >/dev/null 2>&1 || {
    echo "pre-push: pnpm check failed — fix it before pushing (run it to see why)." >&2
    exit 1
  }
fi
exit 0
