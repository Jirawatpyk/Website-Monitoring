-- Shared pgTAP helpers, included by each test file with `\ir _helpers.psql`.
-- Everything here lives inside the test's transaction and is rolled back with it.
set client_min_messages = warning;
create extension if not exists pgtap with schema extensions;

create schema if not exists tests;
grant usage on schema tests to anon, authenticated;

-- An auth user; with a role it is allowlisted first, so the sign-up trigger creates the profile.
create or replace function tests.create_user(p_email text, p_role public.app_role default null)
returns uuid
language plpgsql
security definer
set search_path = ''
as $$
declare
  v_id uuid := gen_random_uuid();
begin
  if p_role is not null then
    insert into private.allowed_emails (email, role) values (lower(p_email), p_role);
  end if;
  insert into auth.users (id, email, aud, role, raw_user_meta_data)
  values (v_id, p_email, 'authenticated', 'authenticated',
          jsonb_build_object('full_name', initcap(split_part(p_email, '@', 1))));
  return v_id;
end;
$$;

-- Act as a signed-in user (the API sets the same role and JWT claims).
create or replace function tests.authenticate_as(p_user_id uuid)
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims',
    json_build_object('sub', p_user_id, 'role', 'authenticated')::text, true);
  perform set_config('role', 'authenticated', true);
end;
$$;

create or replace function tests.as_anon()
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims', json_build_object('role', 'anon')::text, true);
  perform set_config('role', 'anon', true);
end;
$$;

-- Back to the test owner: plain `reset role;` (the session user is postgres).

grant execute on all functions in schema tests to anon, authenticated;

insert into private.allowed_email_domains (domain) values ('example.test')
  on conflict do nothing;
