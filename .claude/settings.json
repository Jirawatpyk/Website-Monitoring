{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm check)",
      "Bash(pnpm check *)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm test:e2e)",
      "Bash(pnpm test:e2e *)",
      "Bash(pnpm --filter * test:e2e)",
      "Bash(pnpm --filter * test:e2e *)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint *)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm build)",
      "Bash(pnpm build *)",
      "Bash(pnpm format)",
      "Bash(pnpm format *)",
      "Bash(pnpm --filter * test)",
      "Bash(pnpm --filter * test *)",
      "Bash(pnpm --filter * test:watch)",
      "Bash(pnpm --filter * typecheck)",
      "Bash(pnpm --filter * typecheck *)",
      "Bash(pnpm --filter * build)",
      "Bash(pnpm --filter * build *)",
      "Bash(pnpm --filter * dev)",
      "Bash(pnpm exec vitest *)",
      "Bash(pnpm exec eslint *)",
      "Bash(pnpm exec prettier *)",
      "Bash(pnpm exec tsc *)",
      "Bash(pnpm db:types)",
      "Bash(pnpm exec supabase status *)",
      "Bash(pnpm exec supabase migration new *)",
      "Bash(pnpm exec supabase migration list *)",
      "Bash(pnpm exec supabase test db)",
      "Bash(pnpm exec supabase test db *)",
      "Bash(pnpm plan:check)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "PowerShell(pnpm install)",
      "PowerShell(pnpm check)",
      "PowerShell(pnpm check *)",
      "PowerShell(pnpm test)",
      "PowerShell(pnpm test *)",
      "PowerShell(pnpm test:e2e)",
      "PowerShell(pnpm test:e2e *)",
      "PowerShell(pnpm lint)",
      "PowerShell(pnpm lint *)",
      "PowerShell(pnpm typecheck)",
      "PowerShell(pnpm typecheck *)",
      "PowerShell(pnpm build)",
      "PowerShell(pnpm build *)",
      "PowerShell(pnpm format)",
      "PowerShell(pnpm format *)",
      "PowerShell(pnpm --filter * test)",
      "PowerShell(pnpm --filter * test *)",
      "PowerShell(pnpm --filter * typecheck)",
      "PowerShell(pnpm --filter * build)",
      "PowerShell(pnpm --filter * build *)",
      "PowerShell(pnpm --filter * dev)",
      "PowerShell(pnpm db:types)",
      "PowerShell(pnpm exec supabase test db)",
      "PowerShell(pnpm exec supabase test db *)",
      "PowerShell(pnpm plan:check)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git branch *)",
      "PowerShell(git switch *)",
      "PowerShell(git checkout -b *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(pnpm add *)",
      "Bash(pnpm --filter * add *)",
      "Bash(pnpm --filter * exec *)",
      "Bash(pnpm db:reset)",
      "Bash(pnpm exec supabase db *)",
      "Bash(vercel *)",
      "PowerShell(git push *)",
      "PowerShell(pnpm add *)",
      "PowerShell(pnpm --filter * add *)",
      "PowerShell(pnpm --filter * exec *)",
      "PowerShell(pnpm db:reset)",
      "PowerShell(pnpm exec supabase db *)",
      "Bash(pnpm db:push:staging)",
      "Bash(pnpm db:reset:staging)",
      "PowerShell(pnpm db:push:staging)",
      "PowerShell(pnpm db:reset:staging)",
      "Bash(pnpm db:push:staging *)",
      "Bash(pnpm db:reset:staging *)",
      "PowerShell(pnpm db:push:staging *)",
      "PowerShell(pnpm db:reset:staging *)",
      "Bash(pnpm pr:merge *)",
      "PowerShell(pnpm pr:merge *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git reset --hard *)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.test)",
      "Read(**/.env.production)",
      "Read(**/.env.keys)",
      "Read(supabase/.env)",
      "Bash(*supabase link*)",
      "PowerShell(*supabase link*)",
      "Bash(*supabase db push*)",
      "PowerShell(*supabase db push*)",
      "Bash(*supabase db reset --linked*)",
      "PowerShell(*supabase db reset --linked*)",
      "Bash(*supabase db reset --db-url*)",
      "PowerShell(*supabase db reset --db-url*)",
      "Read(**/.env.staging.local)",
      "Bash(git push * main)",
      "Bash(git push *:main)",
      "Bash(git push *:refs/heads/main)",
      "PowerShell(git push * main)",
      "PowerShell(git push *:main)",
      "PowerShell(git push *:refs/heads/main)",
      "Bash(gh pr merge *)",
      "PowerShell(gh pr merge *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.mjs\"",
            "timeout": 30,
            "statusMessage": "Formatting with Prettier"
          }
        ]
      }
    ]
  }
}
