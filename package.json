{
  "name": "dxt-monitor",
  "version": "0.0.0",
  "private": true,
  "description": "DxT Website Monitoring & Incident Automation platform",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --filter @dxt/web dev",
    "dev:agent": "pnpm --filter @dxt/vps-agent dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test && node --test \"scripts/**/*.test.mjs\"",
    "test:coverage": "pnpm -r test:coverage && node --test \"scripts/**/*.test.mjs\"",
    "test:e2e": "pnpm --filter @dxt/web test:e2e",
    "check": "pnpm format:check && pnpm plan:check && pnpm lint && pnpm typecheck && pnpm test",
    "plan:check": "node scripts/check-plan-coverage.mjs",
    "pr:merge": "node scripts/pr-merge.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push:staging": "node scripts/db-staging.mjs push",
    "db:reset:staging": "node scripts/db-staging.mjs reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > packages/db/src/database.types.ts",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@jirawatpyk/aura-tokens": "^5.41.0",
    "@next/eslint-plugin-next": "^16.4.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "supabase": "^2.120.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
