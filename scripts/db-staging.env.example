# Copy to .env.staging.local at the repo root (git-ignored) for `pnpm db:push:staging` / `pnpm db:reset:staging`.
# Connection string of the STAGING project (Supabase → Project Settings → Database), percent-encoded.
SUPABASE_STAGING_DB_URL=
# Project refs (the <ref> in https://<ref>.supabase.co). The scripts refuse any URL of the production ref.
SUPABASE_STAGING_PROJECT_REF=
SUPABASE_PROD_PROJECT_REF=
