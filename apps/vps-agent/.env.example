# Local dev: copy to apps/vps-agent/.env. On the VPS: /etc/dxt-agent/<staging|production>.env
# (root:root 0600, one per agent instance, D-019; see deploy/install.md).
# Never commit real values.
API_BASE_URL=http://localhost:3500
INGEST_TOKEN=
HEALTHCHECKS_PING_URL_PROBE_BKK=
HEALTHCHECKS_PING_URL_VERIFIER=
PROBE_SECRET_HEADER_NAME=X-DxT-Monitor
PROBE_SECRET_HEADER_VALUE=
VERIFIER_MAX_SESSIONS=3
VERIFIER_POLL_MS=5000
LOOP_INTERVAL_MS=60000
# Control check (D-027): 2–3 public https URLs from different providers, comma-separated. Optional —
# the default is Google generate_204 + Cloudflare trace.
CONTROL_URLS=
