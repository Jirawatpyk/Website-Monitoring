# Copy to .env.local and fill in. Never commit real values.
# Local Supabase (`pnpm db:start`) prints the URL and keys.

# --- Public (shipped to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3500

# --- Server only ---
# Service role: cron functions and the Ingest / Job APIs only. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=
# Vercel sends "Authorization: Bearer $CRON_SECRET" to every cron path.
CRON_SECRET=
# The Bangkok VPS (probe + browser verifier) authenticates to the Ingest / Job APIs with this.
INGEST_TOKEN=
# Sign-in is limited to this Google Workspace domain (PRD §3) — or several, separated by commas (D-007).
# Each must also be a row in private.allowed_email_domains.
ALLOWED_EMAIL_DOMAIN=

# Google Chat incoming webhooks (PRD §7)
GOOGLE_CHAT_ALERTS_WEBHOOK_URL=
GOOGLE_CHAT_REPORTS_WEBHOOK_URL=

# Email via Resend
RESEND_API_KEY=
ALERT_EMAIL_FROM=

# Secret header sent by probes so client WAFs can allowlist them (PRD §13)
PROBE_SECRET_HEADER_NAME=X-DxT-Monitor
PROBE_SECRET_HEADER_VALUE=
# The Bangkok VPS's fixed public IP, shown on Add site for a WAF allowlist (S05; not a secret, optional).
BKK_PROBE_IP=
# Local development only: let a dev server probe a loopback test target (never set on Vercel or the VPS).
PROBE_ALLOW_PRIVATE_TARGETS=

# Healthchecks.io ping URLs — dead man's switch (PRD §9)
HEALTHCHECKS_PING_URL_ENGINE=
HEALTHCHECKS_PING_URL_PROBE_SIN=
HEALTHCHECKS_PING_URL_PROBE_TYO=
HEALTHCHECKS_PING_URL_NOTIFIER=
HEALTHCHECKS_PING_URL_CRAWLER=

# Defacement alerts from the shared forbidden list and the crawler views (S09c, D-042): on | off.
# Off (the default) logs the findings in the engine summary (defacementHeld) and posts nothing;
# a site's own must_not_contain words alert either way. Production stays off until S09c's week
# without a false positive.
DEFACEMENT_ALERTS=off

# Page-change alerts (S09d, D-046): on | off. Off (the default) logs a changed home page fingerprint in
# the engine summary (pageChangeHeld) and opens nothing; each site also records 14 days from its first
# baseline before it alerts. Production stays off until S09d's two-week record.
PAGE_CHANGE_ALERTS=off

# Twilio voice — Proposal · pending CEO. Leave empty until approved.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
